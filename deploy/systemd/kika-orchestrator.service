[Unit]
Description=Kika-AI Core Orchestrator
Wants=network-online.target engram.service
After=network-online.target engram.service

[Service]
Type=simple
User=dani
Group=dani
WorkingDirectory=/home/dani/kika-cli-pro
EnvironmentFile=/etc/kika/kika.env
ExecStartPre=/usr/bin/python3 -m py_compile /home/dani/kika-cli-pro/core/orchestrator.py
ExecStart=/usr/bin/python3 /home/dani/kika-cli-pro/core/orchestrator.py serve
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/dani/kika-cli-pro
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
